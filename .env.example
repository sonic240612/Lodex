# Copy to .env in the workspace for development, or the app data directory.
# Never commit .env or real credentials. Restart Lodex after editing.
# Priority: process environment > this file > OS keychain.
OPENROUTER_API_KEY=
# MCP headers/env use { "secretRef": "LODEX_MCP_EXAMPLE_TOKEN", "prefix": "Bearer " }.
# Only explicitly configured LODEX_MCP_ references are sent to an MCP server.
LODEX_MCP_EXAMPLE_TOKEN=
# OAuth login stores tokens in a separate .env.mcp beside this file (also ignored).
# Use "oauth": { "clientId": "public-client-id" } in the HTTP MCP server config.
# To choose another file, set LODEX_ENV_FILE to its absolute path before launch.
# Only supported secret names are read; this file cannot set NODE_OPTIONS or VITE_*.
# Telegram integration is not implemented yet.
