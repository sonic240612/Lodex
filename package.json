{
  "name": "lodex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "dev": "npm run prepare:runtime && npm run tauri --workspace @lodex/desktop -- dev",
    "dev:web": "npm run dev --workspace @lodex/desktop",
    "prepare:runtime": "node scripts/build-daemon.mjs && node scripts/prepare-runtime.mjs",
    "build": "npm run prepare:runtime && npm run build --workspace @lodex/desktop",
    "build:desktop": "npm run prepare:runtime && npm run tauri --workspace @lodex/desktop -- build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-daemon.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
